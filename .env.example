# Copy to .env. Keep secrets out of Git. Start with disabled AI or use your inherited DEEPSEEK_API_KEY.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./.data/smartdiary.db
AI_MODE=disabled
JWT_SECRET=development-only-change-before-deploying-32chars
ENCRYPTION_KEY=
REGISTRATION_TOKEN=
POSTGRES_PASSWORD=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
TEXT_MODEL=qwen-plus
VISION_MODEL=qwen3-vl-flash
ASR_MODEL=qwen3-asr-flash
EMBEDDING_MODEL=text-embedding-v4
MONTHLY_BUDGET_YUAN=300
BUDGET_WARNING_YUAN=240
FIXED_MONTHLY_COST_YUAN=80
RESERVE_YUAN=20
# Rates are configurable estimates. Verify the provider's current price before deploying.
TEXT_INPUT_YUAN_PER_MILLION=0.8
TEXT_OUTPUT_YUAN_PER_MILLION=2
ASR_YUAN_PER_SECOND=0.00022
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
ALLOW_PUBLIC_WEB_FETCH=false
